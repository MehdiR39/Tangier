# --- existing Tangier bot -------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRYPTOPANIC_TOKEN=

# --- Tangier Intel (intel/) — all optional, sensible defaults built in ----
# Production RPC (falls back to the public endpoint if unset)
INTEL_RPC_URL=
INTEL_RPC_FALLBACK_URL=https://rpc.mainnet.chain.robinhood.com
# Blockscout explorer API (quota-limited without a key: ~180 calls per window)
INTEL_BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
INTEL_BLOCKSCOUT_API_KEY=
INTEL_DEXSCREENER_URL=https://api.dexscreener.com
# Separate chat for intel alerts (defaults to TELEGRAM_* above)
INTEL_TELEGRAM_BOT_TOKEN=
INTEL_TELEGRAM_CHAT_ID=
INTEL_TELEGRAM_DRY_RUN=0
# Storage / logging / health
INTEL_DB_PATH=data/intel.sqlite
INTEL_LOG_LEVEL=INFO
INTEL_LOG_JSON=0
INTEL_HEALTH_PORT=8787
# Provider limits (public RPC returns 429 above ~5 rps; batch requests are rejected)
INTEL_RPC_RPS=3
INTEL_RPC_CONCURRENCY=1
INTEL_BLOCKSCOUT_RPM=20
INTEL_BLOCKSCOUT_RESERVE_CALLS=25
INTEL_DEXSCREENER_RPM=250
