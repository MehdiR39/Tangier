FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    INTEL_DB_PATH=/app/data/intel.sqlite \
    INTEL_LOGS_DIR=/app/logs \
    INTEL_HEALTH_PORT=8787

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY requirements-intel.txt /app/requirements-intel.txt
RUN pip install --upgrade pip && pip install -r /app/requirements-intel.txt

COPY intel /app/intel
COPY config/intel.yaml /app/config/intel.yaml
COPY tests /app/tests
COPY pytest.ini /app/pytest.ini

RUN mkdir -p /app/data /app/logs /app/results

EXPOSE 8787
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 CMD curl -fsS http://localhost:8787/health || exit 1

CMD ["python", "-m", "intel", "run"]
